# Copy to .env and fill in. .env is gitignored and excluded from the image.

# --- required ---------------------------------------------------------------------
DISCORD_TOKEN=
GARY_GAME_CHANNELS=

# --- the model. Leave unset to run on EchoNarrator: full Discord path, zero spend ---
GEMINI_API_KEY=

# --- optional ---------------------------------------------------------------------
# GARY_PLAYERS=111111111111111111=Caspian Varr;222222222222222222=Liriel
# GARY_FREEFORM_CHANNELS=

# Where the campaign lives ON THE HOST. Defaults to ~/.local/share/gary/campaign,
# deliberately outside the repo so deleting a checkout cannot delete a year of play.
# Point it elsewhere to keep several campaigns side by side.
# GARY_HOST_CAMPAIGN=~/.local/share/gary/fen-marches

# Inside the container this is always /campaign; compose mounts the host path there.
# Set GARY_BACKEND=firestore to keep nothing on this machine at all (§11.1).
# GARY_BACKEND=file
