# Copy to ~/.config/gary/env and fill in:
#
#     mkdir -p ~/.config/gary && chmod 700 ~/.config/gary
#     cp .env.example ~/.config/gary/env && chmod 600 ~/.config/gary/env
#
# Outside the checkout so `rm -rf gary && git clone ...` cannot take your token with it.
# $XDG_CONFIG_HOME is honoured. This template holds no values and is safe to commit.

# --- required ---------------------------------------------------------------------
DISCORD_TOKEN=
GARY_GAME_CHANNELS=

# --- the model. Leave unset to run on EchoNarrator: full Discord path, zero spend ---
GEMINI_API_KEY=

# --- optional ---------------------------------------------------------------------
# GARY_PLAYERS=111111111111111111=Caspian Varr;222222222222222222=Liriel
# GARY_FREEFORM_CHANNELS=

# The campaign lives at ~/.local/share/gary/campaign on the host, which compose mounts
# to /campaign inside the container. To keep a second campaign, add a
# docker-compose.override.yml with a different volume line -- not a variable here, since
# env_file does not reach compose's own interpolation.
# Set GARY_BACKEND=firestore to keep nothing on this machine at all (§11.1).
# GARY_BACKEND=file
